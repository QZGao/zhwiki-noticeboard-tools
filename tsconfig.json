{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "preserve",
		"types": [
			"@types/node",
			"types-mediawiki"
		]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
